// ============================================================
//  src/lib/exportRapor.ts
//  Denetim sonucunu Excel raporuna çevirir (tarayıcıda, sunucu yok)
// ============================================================
import * as XLSX from "xlsx";
import type { DenetimSatiri } from "./matchEngine";

const DURUM_ETIKET: Record<string, string> = {
  fark_var: "ALEYHE FARK",
  belirsiz_fark_kesin: "ALEYHE (ÇEŞİT BELİRSİZ, ALT SINIR)",
  uygun: "Uygun",
  lehe_fark: "Lehte / önemsiz",
  belirsiz_cesit: "Çeşit belirsiz — karar bekliyor",
  listede_yok: "Listede yok",
  fiyat_verilmemis: "Fiyat verilmemiş",
  birim_uyusmazligi: "Birim uyuşmazlığı",
  eslesmedi: "Master ürün bulunamadı",
};

export function raporIndir(params: {
  dosyaAdi: string;
  faturaDosya: string;
  faturaTarihi: string;
  tedarikci: string;
  listeEtiketleri: string[];
  satirlar: DenetimSatiri[];
}) {
  const { dosyaAdi, faturaDosya, faturaTarihi, tedarikci, listeEtiketleri, satirlar } = params;

  const aleyheSatirlar = satirlar.filter(
    (s) => s.durum === "fark_var" || s.durum === "belirsiz_fark_kesin"
  );
  const toplamFark = aleyheSatirlar.reduce((t, s) => t + (s.fark_toplam ?? 0), 0);

  // --- Sayfa 1: Özet ---
  const ozet = [
    ["Fiyat Farkı Denetim Raporu"],
    [],
    ["Tedarikçi", tedarikci],
    ["Fatura", faturaDosya],
    ["Fatura tarihi", faturaTarihi],
    ["Baz alınan liste(ler)", listeEtiketleri.join(", ")],
    ["Rapor tarihi", new Date().toLocaleString("tr-TR")],
    [],
    ["Toplam satır", satirlar.length],
    ["Aleyhe fark bulunan (kesin)", satirlar.filter((s) => s.durum === "fark_var").length],
    [
      "Aleyhe fark (çeşit belirsiz, alt sınır)",
      satirlar.filter((s) => s.durum === "belirsiz_fark_kesin").length,
    ],
    ["Karar bekleyen (çeşit belirsiz)", satirlar.filter((s) => s.durum === "belirsiz_cesit").length],
    ["Listede olmayan", satirlar.filter((s) => s.durum === "listede_yok").length],
    ["Birim uyuşmazlığı", satirlar.filter((s) => s.durum === "birim_uyusmazligi").length],
    [],
    ["TOPLAM İADE TALEBİ (TL)", Number(toplamFark.toFixed(2))],
  ];
  const wsOzet = XLSX.utils.aoa_to_sheet(ozet);
  wsOzet["!cols"] = [{ wch: 32 }, { wch: 40 }];

  // --- Sayfa 2: İade talebine giren satırlar ---
  const iadeBaslik = [
    "Ürün",
    "Miktar",
    "Fatura Fiyatı",
    "Baz Fiyat",
    "Baz Ürün",
    "Birim Fark",
    "Toplam Fark (TL)",
    "Durum",
  ];
  const iadeSatirlari = aleyheSatirlar.map((s) => [
    s.urun_adi,
    s.miktar,
    s.fatura_fiyati,
    s.baz_fiyat ?? `≤ ${s.aday_max}`,
    s.baz_urun_adi ?? `(${s.aday_sayisi} çeşit arasından en pahalısı)`,
    s.fark_birim,
    Number((s.fark_toplam ?? 0).toFixed(2)),
    DURUM_ETIKET[s.durum] ?? s.durum,
  ]);
  const wsIade = XLSX.utils.aoa_to_sheet([iadeBaslik, ...iadeSatirlari]);
  wsIade["!cols"] = [
    { wch: 22 }, { wch: 9 }, { wch: 12 }, { wch: 12 },
    { wch: 26 }, { wch: 11 }, { wch: 14 }, { wch: 28 },
  ];

  // --- Sayfa 3: Tüm satırlar (denetim izi) ---
  const tumBaslik = [
    "Ürün", "Miktar", "Fatura Fiyatı", "Fatura Birim",
    "Durum", "Baz Fiyat", "Baz Ürün", "Aday Sayısı",
    "Aday Min", "Aday Max", "Toplam Fark", "Seçim",
  ];
  const tumSatirlar = satirlar.map((s) => [
    s.urun_adi, s.miktar, s.fatura_fiyati, s.fatura_birim_norm,
    DURUM_ETIKET[s.durum] ?? s.durum, s.baz_fiyat, s.baz_urun_adi,
    s.aday_sayisi, s.aday_min, s.aday_max,
    s.fark_toplam !== null ? Number(s.fark_toplam.toFixed(2)) : null,
    s.secim_tipi === "manuel" ? "Manuel" : "Otomatik",
  ]);
  const wsTum = XLSX.utils.aoa_to_sheet([tumBaslik, ...tumSatirlar]);
  wsTum["!cols"] = [
    { wch: 22 }, { wch: 8 }, { wch: 12 }, { wch: 10 },
    { wch: 28 }, { wch: 10 }, { wch: 24 }, { wch: 10 },
    { wch: 9 }, { wch: 9 }, { wch: 12 }, { wch: 10 },
  ];

  // --- Sayfa 4: Listede hiç olmayanlar (tedarikçiye sorulacak) ---
  const yokSatirlar = satirlar
    .filter((s) => s.durum === "listede_yok")
    .map((s) => [s.urun_adi, s.miktar, s.fatura_fiyati]);
  const wsYok = XLSX.utils.aoa_to_sheet([
    ["Bu kalemler fiyat listesinde bulunamadı — tedarikçiden güncel liste isteyin"],
    [],
    ["Ürün", "Miktar", "Fatura Fiyatı"],
    ...yokSatirlar,
  ]);
  wsYok["!cols"] = [{ wch: 24 }, { wch: 9 }, { wch: 12 }];

  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, wsOzet, "Özet");
  XLSX.utils.book_append_sheet(wb, wsIade, "İade Talebi");
  XLSX.utils.book_append_sheet(wb, wsTum, "Tüm Satırlar");
  XLSX.utils.book_append_sheet(wb, wsYok, "Listede Yok");

  XLSX.writeFile(wb, dosyaAdi);
}
