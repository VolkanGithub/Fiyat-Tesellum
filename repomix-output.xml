"use client";

import { useState, ChangeEvent } from "react";
import { Upload, FileText, AlertCircle, ArrowUpRight } from "lucide-react";

// API'den gelecek verinin şablonunu (Interface) kesin ve net bir şekilde tanımlıyoruz
interface ZamliUrun {
  stokAdi: string;
  oncekiFiyat: number;
  alisFiyati: number;
  farkTl: number;
  farkYuzde: number;
}

export default function TesellumAnaliz() {
  const [file, setFile] = useState<File | null>(null);
  const [loading, setLoading] = useState(false);
  const [results, setResults] = useState<ZamliUrun[]>([]);
  const [error, setError] = useState<string | null>(null);

  const handleFileChange = (e: ChangeEvent<HTMLInputElement>) => {
    if (e.target.files && e.target.files.length > 0) {
      setFile(e.target.files[0]);
      setError(null);
      setResults([]); // Yeni dosya seçildiğinde eski sonuçları temizle
    }
  };

  const handleUpload = async () => {
    if (!file) {
      setError("Lütfen önce bir PDF tesellüm fişi seçin.");
      return;
    }

    setLoading(true);
    setError(null);

    // Dosyayı API'ye göndermek için FormData kullanıyoruz
    const formData = new FormData();
    formData.append("file", file);

    try {
      const response = await fetch("/api/read-pdf", {
        method: "POST",
        body: formData,
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "Sunucu hatası oluştu.");
      }

      // Gelen veriyi (data.data) listeye aktarıyoruz
      setResults(data.data as ZamliUrun[]);

      if (data.data.length === 0) {
        setError("Bu fişte fiyatı artan (zamlı) hiçbir ürün bulunamadı.");
      }

    } catch (err: unknown) {
      const errorMessage = err instanceof Error ? err.message : String(err);
      setError("Analiz sırasında hata: " + errorMessage);
    } finally {
      setLoading(false);
    }
  };

  // Para ve Yüzde formatlayıcı yardımcı fonksiyonlar
  const formatCurrency = (value: number) => new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' }).format(value);
  const formatPercent = (value: number) => `%${value.toFixed(2)}`;

  return (
    <main className="min-h-screen bg-slate-50 p-8">
      <div className="max-w-6xl mx-auto space-y-8">

        {/* Üst Kısım: Yükleme Alanı */}
        <div className="bg-white rounded-xl shadow-sm border border-slate-200 p-8">
          <div className="mb-6">
            <h1 className="text-2xl font-bold text-slate-800">Tesellüm Fişi Zam Analizi</h1>
            <p className="text-slate-500 mt-1">Sistemden aldığınız PDF fişini yükleyin, fiyatı artan ürünleri anında tespit edelim.</p>
          </div>

          <div className="flex flex-col md:flex-row gap-4 items-start md:items-center">
            <div className="flex-1 w-full border-2 border-dashed border-slate-300 rounded-lg p-6 flex flex-col items-center justify-center bg-slate-50 hover:bg-slate-100 transition">
              <FileText className="w-10 h-10 text-rose-500 mb-3" />
              <input
                type="file"
                accept="application/pdf"
                onChange={handleFileChange}
                className="block w-full text-sm text-slate-500
                  file:mr-4 file:py-2 file:px-4
                  file:rounded-full file:border-0
                  file:text-sm file:font-semibold
                  file:bg-rose-50 file:text-rose-700
                  hover:file:bg-rose-100 cursor-pointer text-center"
              />
            </div>

            <button
              onClick={handleUpload}
              disabled={!file || loading}
              className={`w-full md:w-auto flex items-center justify-center gap-2 py-4 px-8 rounded-lg text-white font-medium transition h-full min-h-[140px]
                ${(!file || loading) ? "bg-slate-400 cursor-not-allowed" : "bg-rose-600 hover:bg-rose-700"}`}
            >
              {loading ? (
                <span className="animate-pulse">Analiz Ediliyor...</span>
              ) : (
                <div className="flex flex-col items-center gap-2">
                  <Upload className="w-6 h-6" />
                  <span>Fişi Analiz Et</span>
                </div>
              )}
            </button>
          </div>

          {error && (
            <div className="mt-4 p-4 rounded-lg flex items-center gap-3 bg-red-50 text-red-800 border border-red-200">
              <AlertCircle className="w-5 h-5" />
              <p>{error}</p>
            </div>
          )}
        </div>

        {/* Alt Kısım: Sonuç Tablosu */}
        {results.length > 0 && (
          <div className="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <div className="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
              <h2 className="text-lg font-semibold text-slate-800 flex items-center gap-2">
                <AlertCircle className="w-5 h-5 text-amber-500" />
                Zam Tespit Edilen Ürünler ({results.length})
              </h2>
            </div>
            <div className="overflow-x-auto">
              <table className="w-full text-left text-sm text-slate-600">
                <thead className="bg-slate-100 text-slate-700 font-medium">
                  <tr>
                    <th className="px-6 py-4">Stok Adı</th>
                    <th className="px-6 py-4 text-right">Önceki Fiyat</th>
                    <th className="px-6 py-4 text-right">Yeni Alış Fiyatı</th>
                    <th className="px-6 py-4 text-right">Fark (TL)</th>
                    <th className="px-6 py-4 text-right">Zam Oranı (%)</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-100">
                  {results.map((urun, index) => (
                    <tr key={index} className="hover:bg-slate-50 transition">
                      <td className="px-6 py-4 font-medium text-slate-800">{urun.stokAdi}</td>
                      <td className="px-6 py-4 text-right">{formatCurrency(urun.oncekiFiyat)}</td>
                      <td className="px-6 py-4 text-right font-medium">{formatCurrency(urun.alisFiyati)}</td>
                      <td className="px-6 py-4 text-right text-rose-600 font-medium">
                        +{formatCurrency(urun.farkTl)}
                      </td>
                      <td className="px-6 py-4 text-right">
                        <span className="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-rose-100 text-rose-700 font-semibold text-xs">
                          <ArrowUpRight className="w-3 h-3" />
                          {formatPercent(urun.farkYuzde)}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

      </div>
    </main>
  );
}
</file>

