<file path="src/app/api/read-pdf/route.ts">
import { NextResponse } from 'next/server';

// 1. DÜZELTME: pdf-parse kütüphanesinin tip tanımlamalarında default export eksik. 
// ESLint ve TypeScript'i kızdırmadan dahil etmenin en güvenli yolu:
// @ts-expect-error - pdf-parse module lacks proper default export types
import pdf from 'pdf-parse';

export async function POST(request: Request) {
  try {
    const formData = await request.formData();
    const file = formData.get('file') as File;

    if (!file) {
      return NextResponse.json({ error: 'Dosya bulunamadı.' }, { status: 400 });
    }

    const arrayBuffer = await file.arrayBuffer();
    const buffer = Buffer.from(arrayBuffer);

    const data = await pdf(buffer);
    const text = data.text;

    const results = [];
    const lines = text.split('\n');

    for (const line of lines) {
      const parts = line.trim().split(/\s+/);

      if (parts.length < 10) continue;

      const parseNumber = (str: string) => parseFloat(str.replace(/\./g, '').replace(',', '.'));

      const netFiyatStr = parts[parts.length - 2];
      const sonAlisStr = parts[parts.length - 3];

      try {
        const netFiyat = parseNumber(netFiyatStr);
        const sonAlis = parseNumber(sonAlisStr);

        if (!isNaN(netFiyat) && !isNaN(sonAlis) && netFiyat > sonAlis) {
          const farkTl = netFiyat - sonAlis;
          const farkYuzde = (farkTl / sonAlis) * 100;

          let birimIdx = -1;
          for (let i = 0; i < parts.length; i++) {
            if (parts[i] === 'Kg' || parts[i] === 'Adet') {
              birimIdx = i;
              break;
            }
          }

          if (birimIdx !== -1) {
            let isimParts = parts.slice(1, birimIdx - 1);

            if (isimParts.length > 1 && isimParts[isimParts.length - 1] === 'paket') {
              isimParts = parts.slice(1, birimIdx - 3);
            }

            const isim = isimParts.join(' ');

            results.push({
              stokAdi: isim,
              oncekiFiyat: sonAlis,
              alisFiyati: netFiyat,
              farkTl: farkTl,
              farkYuzde: farkYuzde
            });
          }
        }
      } catch {
        // 2. DÜZELTME: Kullanılmayan 'e' değişkenini sildik. (no-unused-vars çözüldü)
        // İlgisiz satırlarda hata olursa sessizce atlıyoruz.
      }
    }

    return NextResponse.json({ success: true, data: results });

  } catch (error: unknown) {
    // 3. DÜZELTME: 'any' yerine 'unknown' kullandık. (no-explicit-any çözüldü)
    const errorMessage = error instanceof Error ? error.message : String(error);
    console.error("PDF okuma hatası:", errorMessage);
    return NextResponse.json({ error: errorMessage }, { status: 500 });
  }
}
